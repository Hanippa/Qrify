{
  "manifest_version": 3,
  "name": "Qrify",
  "description": "Qr code generator and scanner, with customization options, and an image qr code generator",
  "version": "10.0",
  "author": "https://github.com/hanippa", 
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "permissions": [
    "activeTab",
    "downloads",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "images/icon-128.png"
  }
}


